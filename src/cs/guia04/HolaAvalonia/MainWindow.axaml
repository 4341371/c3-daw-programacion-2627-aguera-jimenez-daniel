<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="HolaAvalonia.MainWindow"
        Title="HolaAvalonia">
<StackPanel Margin="20" Spacing="10">

    <TextBlock Text="Mi primera aplicación gráfica" FontSize="20"/>
    <TextBlock Text="Escribe tu nombre:"/>
    <TextBox Name="txtNombre"/>
    <Button Content="Saludar" Click="Saludar_Click"/>
    <TextBlock Name="txtResultado" Text="Aquí aparecerá el saludo."/>
    
</StackPanel>

</Window>
